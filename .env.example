SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=you@example.com

# Safety controls
WEEKLY_SEND_LIMIT=100
DAILY_SEND_LIMIT=20
MINIMUM_SEND_DELAY_SECONDS=90

# Optional standards-based receipt request; recipients may decline.
# This does not use a hidden tracking pixel.
REQUEST_READ_RECEIPTS=false

# Required before exposing the app beyond localhost.
# Use a long random value (for example: openssl rand -hex 32).
CAREER_DISPATCH_ACCESS_TOKEN=

# Optional: comma-separated JSON feed URLs under your control
CUSTOM_JOB_FEEDS=
